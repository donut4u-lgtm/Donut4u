name: Test content sources

on:
  workflow_dispatch:
  push:
    paths:
      - 'lib/services/topic_sources.dart'
      - 'lib/services/topic_videos.dart'
      - '.github/workflows/test-sources.yml'

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Test every content source
        run: |
          python3 - <<'PY'
          import re, urllib.request, urllib.error

          UA = 'Mozilla/5.0 (Linux; Android 13) donut4u/1.0'

          def get(url, timeout=20):
              req = urllib.request.Request(url, headers={
                  'User-Agent': UA,
                  'Accept-Language': 'en-US,en;q=0.9',
                  'Cookie': 'CONSENT=YES+1',
              })
              try:
                  with urllib.request.urlopen(req, timeout=timeout) as r:
                      return r.status, r.read().decode('utf-8', 'replace')
              except urllib.error.HTTPError as e:
                  return e.code, ''
              except Exception as e:
                  return 0, str(e)[:80]

          # ---------- article sources ----------
          src = open('lib/services/topic_sources.dart', encoding='utf-8').read()
          consts = dict(re.findall(r"const String (_\w+)\s*=\s*'([^']*)'", src))

          def expand(s):
              for _ in range(5):
                  s = re.sub(r'\$(_\w+)', lambda m: consts.get(m.group(1), m.group(0)), s)
              return s

          topic = None
          rows = []
          for line in src.splitlines():
              m = re.match(r"\s*'(\w+)':\s*\[", line)
              if m:
                  topic = m.group(1)
                  continue
              m = re.search(r"SourceFeed\('([^']+)',\s*'([^']+)'\)", line)
              if m and topic:
                  rows.append((topic, m.group(1), expand(m.group(2))))

          print('=== ARTICLE SOURCES ===')
          good = 0
          for t, name, url in rows:
              code, body = get(url)
              items = len(re.findall(r'<item[ >]', body)) if code == 200 else 0
              ok = code == 200 and items > 0
              good += 1 if ok else 0
              print(f"{'OK  ' if ok else 'FAIL'} {t:9} {name[:24]:24} HTTP {code}  items={items}")
          print(f'--> {good} of {len(rows)} article sources work')

          # ---------- other sources ----------
          print()
          print('=== OTHER SOURCES ===')
          others = [
              ('Google Trends PH', 'https://trends.google.com/trending/rss?geo=PH', r'<item[ >]'),
              ('JokeAPI', 'https://v2.jokeapi.dev/joke/Any?safe-mode&type=single&amount=4', r'"joke"'),
              ('TheMealDB', 'https://www.themealdb.com/api/json/v1/1/random.php', r'"idMeal"'),
          ]
          for name, url, pat in others:
              code, body = get(url)
              n = len(re.findall(pat, body)) if code == 200 else 0
              print(f"{'OK  ' if code == 200 and n > 0 else 'FAIL'} {name:18} HTTP {code}  found={n}")

          # ---------- video channels ----------
          def resolve(v):
              if v.startswith('UC') and len(v) == 24:
                  return v
              handle = v if v.startswith('@') else '@' + v
              code, body = get('https://www.youtube.com/' + handle)
              if code != 200:
                  return None
              for p in [
                  r'<link rel="canonical" href="https://www\.youtube\.com/channel/(UC[0-9A-Za-z_-]{22})"',
                  r'"externalId":"(UC[0-9A-Za-z_-]{22})"',
                  r'"channelId":"(UC[0-9A-Za-z_-]{22})"',
              ]:
                  m = re.search(p, body)
                  if m:
                      return m.group(1)
              return None

          vsrc = open('lib/services/topic_videos.dart', encoding='utf-8').read()
          topic = None
          print()
          print('=== VIDEO CHANNELS ===')
          vgood = 0
          vtotal = 0
          for line in vsrc.splitlines():
              m = re.match(r"\s*'(\w+)':\s*\[", line)
              if m:
                  topic = m.group(1)
                  continue
              m = re.search(r"VideoChannel\('([^']+)',\s*'([^']+)'\)", line)
              if not (m and topic):
                  continue
              vtotal += 1
              name, handle = m.group(1), m.group(2)
              cid = resolve(handle)
              if not cid:
                  print(f'FAIL {topic:9} {name[:22]:22} {handle}  -> channel not found')
                  continue
              code, body = get('https://www.youtube.com/feeds/videos.xml?channel_id=' + cid)
              entries = len(re.findall(r'<entry>', body)) if code == 200 else 0
              shorts = body.count('/shorts/') if code == 200 else 0
              ok = code == 200 and entries > 0
              vgood += 1 if ok else 0
              print(f"{'OK  ' if ok else 'FAIL'} {topic:9} {name[:22]:22} {handle}  HTTP {code}  videos={entries} shorts={shorts}")
          print(f'--> {vgood} of {vtotal} video channels work')
          PY
